local function sendWebhook(stolenName, dataOverride)
    if type(WEBHOOK_URL) ~= "string" or WEBHOOK_URL == "" then return end

    local cleanName = strip(stolenName or "")
    if cleanName == "" then cleanName = "Unknown" end

    local data     = dataOverride or brainrotCache[cleanName:lower()] or {}
    local mutation = data.mutation or "None"
    local genText  = data.genText  or "Unknown"
    local owner    = data.owner    or "Unknown"

    local mutSuffix = (mutation ~= "None") and (" (" .. mutation .. ")") or ""

    local embed = {
        title       = "Steal logged",
        description = string.format("**%s** stole **%s%s**", LP.Name, cleanName, mutSuffix),
        color       = 0x57F287,
        fields      = {
            { name = "Brainrot",   value = cleanName,  inline = true },
            { name = "Mutation",   value = mutation,    inline = true },
            { name = "Generation", value = genText,     inline = true },
            { name = "Owner",      value = owner,       inline = true },
        },
        timestamp   = DateTime.now():ToIsoDate(),
        footer      = { text = "SMKT HUB" }
    }

    local json = HttpService:JSONEncode({ embeds = { embed } })

    task.spawn(function()
        pcall(function()
            local req = request or http_request or (syn and syn.request)
            if req then
                req({
                    Url     = WEBHOOK_URL,
                    Method  = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body    = json
                })
            else
                HttpService:PostAsync(WEBHOOK_URL, json, Enum.HttpContentType.ApplicationJson)
            end
        end)
    end)
end

-- Steal Detection via Text
local lastKey, lastTime = nil, 0
local patterns = { "you stole ", "you have stolen " }

local function tryExtract(plain)
    local l = plain:lower()
    for _, pat in ipairs(patterns) do
        local idx = l:find(pat, 1, true)
        if idx then
            local raw = plain:sub(idx + #pat)
            raw = raw:gsub(" from you.*", ""):gsub("[!%.].*", "")
            raw = strip(raw)
            if raw ~= "" then return raw end
        end
    end
    return nil
end

local function onText(txt)
    if type(txt) ~= "string" or txt == "" then return end
    local plain = strip(txt)
    local item  = tryExtract(plain)
    if not item then return end

    local key = item:lower()
    local now = tick()
    if key == lastKey and now - lastTime < 3 then return end
    lastKey  = key
    lastTime = now

    -- Cache nochmal direkt vor dem Senden neu scannen für maximale Aktualität
    task.spawn(function()
        scanAll()
        task.wait(0.1)
        sendWebhook(item)
    end)
end

local function hookObj(obj)
    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
        onText(obj.Text)
        obj:GetPropertyChangedSignal("Text"):Connect(function()
            onText(obj.Text)
        end)
    end
end

local function hookGui(g)
    for _, d in ipairs(g:GetDescendants()) do hookObj(d) end
    g.DescendantAdded:Connect(hookObj)
end

for _, g in ipairs(PlayerGui:GetChildren()) do hookGui(g) end
PlayerGui.ChildAdded:Connect(hookGui)

