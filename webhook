local function shouldSend(cleanName, data)
    if ALWAYS_SEND[cleanName:lower()] then return true end
    if data and data.genValue and data.genValue >= MIN_GEN_VALUE then return true end
    return false
end

local function getRequestFunc()
    local r =
        (syn and syn.request) or
        (http and http.request) or
        (fluxus and fluxus.request) or
        (krnl and krnl.request) or
        request or
        http_request
    return r
end

local function sendWebhook(stolenName)
    if type(WEBHOOK_URL) ~= "string" or WEBHOOK_URL == "" then return end

    local cleanName = strip(stolenName or "")
    if cleanName == "" then return end

    local baseName = cleanName:gsub("%s*%([^)]*%)", "")
    baseName = strip(baseName)
    if baseName == "" then baseName = cleanName end

    local key       = baseName:lower()
    local data      = brainrotCache[key] or {}
    local mutation  = data.mutation or "None"
    local genText   = data.genText  or "Unknown"
    local owner     = data.owner    or "Unknown"

    if not shouldSend(baseName, data) then return end

    local mutSuffix = (mutation ~= "None") and (" (" .. mutation .. ")") or ""
    local embed = {
        title       = "Steal logged",
        description = string.format("**%s** stole **%s%s**", LP.Name, baseName, mutSuffix),
        color       = 0x57F287,
        fields      = {
            { name = "Brainrot",   value = baseName, inline = true },
            { name = "Mutation",   value = mutation, inline = true },
            { name = "Generation", value = genText,  inline = true },
            { name = "Owner",      value = owner,    inline = true },
        },
        timestamp   = DateTime.now():ToIsoDate(),
        footer      = { text = "SMKT HUB" }
    }

    local json = HttpService:JSONEncode({ embeds = { embed } })

    task.spawn(function()
        local req = getRequestFunc()
        if req then
            pcall(function()
                req({
                    Url     = WEBHOOK_URL,
                    Method  = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body    = json
                })
            end)
        else
            pcall(function()
                HttpService:PostAsync(WEBHOOK_URL, json, Enum.HttpContentType.ApplicationJson)
            end)
        end
    end)
end

local lastKey, lastTime = nil, 0
local stealPatterns = { "you stole ", "you have stolen " }

local function tryExtract(plain)
    local l = plain:lower()
    for _, pat in ipairs(stealPatterns) do
        local idx = l:find(pat, 1, true)
        if idx then
            local raw = plain:sub(idx + #pat)
            raw = raw:gsub(" from you.*", ""):gsub("[!%.].*", "")
            raw = strip(raw)
            if raw ~= "" then return raw end
        end
    end
    return nil
end

local function onText(txt)
    if type(txt) ~= "string" or txt == "" then return end
    local plain = strip(txt)
    local item  = tryExtract(plain)
    if not item then return end

    local baseKey = strip(item:gsub("%s*%([^)]*%)", "")):lower()
    if baseKey == "" then baseKey = item:lower() end

    local now = tick()
    if baseKey == lastKey and now - lastTime < 3 then return end
    lastKey  = baseKey
    lastTime = now

    task.spawn(function()
        scanAll()
        task.wait(0.1)
        sendWebhook(item)
    end)
end

local function hookObj(obj)
    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
        onText(obj.Text)
        obj:GetPropertyChangedSignal("Text"):Connect(function()
            onText(obj.Text)
        end)
    end
end

local function hookGui(g)
    for _, d in ipairs(g:GetDescendants()) do
        hookObj(d)
    end
    g.DescendantAdded:Connect(hookObj)
end

for _, g in ipairs(PlayerGui:GetChildren()) do
    hookGui(g)
end

